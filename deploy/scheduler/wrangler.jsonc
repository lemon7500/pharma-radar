{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "pharma-radar-collection-scheduler",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["7,27,47 * * * *"]
  },
  "vars": {
    "ENABLE": "false",
    "DRY_RUN": "true"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
